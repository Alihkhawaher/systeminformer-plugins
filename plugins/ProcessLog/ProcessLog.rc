#include "resource.h"
#include <winres.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_PROCESSLOG DIALOGEX 0, 0, 600, 320
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "Process log"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Search:",IDC_SEARCH_LABEL,4,6,28,8
    EDITTEXT        IDC_SEARCH,34,4,190,12,ES_AUTOHSCROLL
    CONTROL         "Only &short-lived (< 1 s)",IDC_SHORTONLY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,232,5,100,10
    CONTROL         "Only &running",IDC_RUNNINGONLY,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,336,5,60,10
    PUSHBUTTON      "&Copy",IDC_COPY,474,3,50,14
    PUSHBUTTON      "&Export CSV...",IDC_EXPORT,528,3,68,14
    CONTROL         "",IDC_LIST,"SysListView32",LVS_REPORT | LVS_SHOWSELALWAYS | LVS_OWNERDATA | WS_BORDER | WS_TABSTOP,4,21,592,284
    LTEXT           "",IDC_STATUS,4,309,592,8,SS_ENDELLIPSIS
END

IDD_DETAILS DIALOGEX 0, 0, 400, 240
STYLE DS_SETFONT | DS_FIXEDSYS | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Process details"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_DETAILS_TEXT,4,4,392,212,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL
    PUSHBUTTON      "&Copy",IDC_DETAILS_COPY,288,221,50,14
    DEFPUSHBUTTON   "Close",IDOK,346,221,50,14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Alihkhawaher"
            VALUE "FileDescription", "Process log plugin for System Informer"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "ProcessLog"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "ProcessLog.dll"
            VALUE "ProductName", "ProcessLog"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
