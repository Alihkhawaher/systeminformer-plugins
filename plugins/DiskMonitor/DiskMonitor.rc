#include "resource.h"
#include <winres.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_DISKS_DIALOG DIALOGEX 0, 0, 315, 236
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Disks"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Disks",IDC_TITLE,0,0,120,21
    RTEXT           "Disk name",IDC_DISKNAME,123,4,192,16,SS_WORDELLIPSIS
    CONTROL         "",IDC_TILES_LAYOUT,"Static",NOT WS_VISIBLE,0,22,315,44
    LTEXT           "Panel layout",IDC_PANEL_LAYOUT,0,90,315,146,NOT WS_VISIBLE
    CONTROL         "",IDC_GRAPH_LAYOUT,"Static",SS_NOTIFY | NOT WS_VISIBLE,0,68,315,20
    LTEXT           "",IDC_LABEL0,73,0,140,8
    LTEXT           "",IDC_LABEL1,73,5,140,8
    LTEXT           "",IDC_LABEL2,73,11,140,8
    LTEXT           "",IDC_LABEL3,73,16,140,8
END

IDD_DISK_PANEL DIALOGEX 0, 0, 315, 146
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_SYSMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Health",IDC_STATIC,0,0,112,45
    LTEXT           "-",IDC_HEALTH_V,6,10,100,10,SS_ENDELLIPSIS
    LTEXT           "",IDC_PROBLEMS_V,6,21,100,22
    GROUPBOX        "Drive",IDC_STATIC,116,0,98,45
    LTEXT           "Temperature",IDC_STATIC,122,11,44,8
    LTEXT           "Powered on",IDC_STATIC,122,21,44,8
    LTEXT           "Power cycles",IDC_STATIC,122,31,44,8
    RTEXT           "-",IDC_TEMP_V,166,11,42,8,SS_ENDELLIPSIS
    RTEXT           "-",IDC_POWERON_V,166,21,42,8,SS_ENDELLIPSIS
    RTEXT           "-",IDC_CYCLES_V,166,31,42,8,SS_ENDELLIPSIS
    GROUPBOX        "Lifetime",IDC_STATIC,218,0,97,45
    LTEXT           "Wear",IDC_STATIC,224,11,32,8
    LTEXT           "Written",IDC_STATIC,224,21,32,8
    LTEXT           "Read",IDC_STATIC,224,31,32,8
    RTEXT           "-",IDC_WEAR_V,256,11,53,8,SS_ENDELLIPSIS
    RTEXT           "-",IDC_WRITTEN_V,256,21,53,8,SS_ENDELLIPSIS
    RTEXT           "-",IDC_READ_V,256,31,53,8,SS_ENDELLIPSIS
    LTEXT           "-",IDC_VOLUMES_V,0,48,315,8,SS_ENDELLIPSIS
    CONTROL         "",IDC_APPS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,0,58,128,88
    CONTROL         "",IDC_SMART,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,132,58,183,88
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Per-disk monitor with SMART health for System Informer"
            VALUE "FileVersion", "1.1.0.0"
            VALUE "InternalName", "DiskMonitor"
            VALUE "OriginalFilename", "DiskMonitor.dll"
            VALUE "ProductName", "systeminformer-plugins"
            VALUE "ProductVersion", "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
