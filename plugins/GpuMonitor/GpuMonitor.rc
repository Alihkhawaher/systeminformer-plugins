#include "resource.h"
#include <winres.h>

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDD_GPU_DIALOG DIALOGEX 0, 0, 315, 186
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "GPU"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "GPU",IDC_TITLE,0,0,120,21
    RTEXT           "GPU name",IDC_GPUNAME,123,4,192,16,SS_WORDELLIPSIS
    LTEXT           "Panel layout",IDC_PANEL_LAYOUT,0,87,315,98,NOT WS_VISIBLE
    CONTROL         "",IDC_GRAPH_LAYOUT,"Static",SS_NOTIFY | NOT WS_VISIBLE,0,22,315,62
    LTEXT           "",IDC_LABEL0,73,0,140,8
    LTEXT           "",IDC_LABEL1,73,5,140,8
    LTEXT           "",IDC_LABEL2,73,11,140,8
    LTEXT           "",IDC_LABEL3,73,16,140,8
    LTEXT           "",IDC_LABEL4,73,22,140,8
    LTEXT           "",IDC_LABEL5,73,27,140,8
END

IDD_GPU_PANEL DIALOGEX 0, 0, 315, 98
STYLE DS_SETFONT | DS_FIXEDSYS | DS_CONTROL | WS_CHILD | WS_SYSMENU
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Memory",IDC_STATIC,0,0,120,35
    LTEXT           "Dedicated",IDC_STATIC,6,11,36,8
    LTEXT           "Shared",IDC_STATIC,6,22,36,8
    RTEXT           "-",IDC_DEDICATED_V,42,11,72,8,SS_ENDELLIPSIS
    RTEXT           "-",IDC_SHARED_V,42,22,72,8,SS_ENDELLIPSIS
    GROUPBOX        "Power",IDC_STATIC,124,0,84,35
    LTEXT           "Current",IDC_STATIC,130,11,28,8
    LTEXT           "Limit",IDC_STATIC,130,22,28,8
    RTEXT           "-",IDC_POWER_V,158,11,44,8,SS_ENDELLIPSIS
    RTEXT           "-",IDC_POWERLIMIT_V,158,22,44,8,SS_ENDELLIPSIS
    GROUPBOX        "Clocks / device",IDC_STATIC,212,0,103,35
    LTEXT           "SM",IDC_STATIC,218,11,14,8
    RTEXT           "-",IDC_SMCLOCK_V,230,11,34,8,SS_ENDELLIPSIS
    LTEXT           "Mem",IDC_STATIC,218,22,16,8
    RTEXT           "-",IDC_MEMCLOCK_V,230,22,34,8,SS_ENDELLIPSIS
    RTEXT           "-",IDC_DRIVER_V,266,11,45,8,SS_ENDELLIPSIS
    RTEXT           "-",IDC_FAN_V,266,22,45,8,SS_ENDELLIPSIS
    CONTROL         "",IDC_APPS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_BORDER | WS_TABSTOP,0,39,315,59
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Per-GPU monitor plugin for System Informer"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "GpuMonitor"
            VALUE "OriginalFilename", "GpuMonitor.dll"
            VALUE "ProductName", "systeminformer-plugins"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
